# Launch Finder — public paper-only snapshot
# Copy to .env and fill YOUR keys. Never commit .env.
# Defaults below keep the desk paper-only and disarmed.

# --- Core (optional for a keyless smoke; add for a serious feed) ---
# HELIUS_API_KEY=
# SOLANA_RPC_URL=
# SOLANA_WS_URL=
# GMGN_API_KEY=
# FOMO_API_KEY=
# BITQUERY_API_TOKEN=
# GITHUB_TOKEN=
# TWITTER_BEARER_TOKEN=
# OPENAI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
# DATABASE_URL=sqlite:///./data/launchfinder.db

# --- Process role: all | api | worker ---
LAUNCHFINDER_ROLE=all
HOST=0.0.0.0
PORT=8080
POLL_SECONDS=12
LOG_LEVEL=INFO
DATA_DIR=./data

# --- HARD LOCKS (keep these) ---
# Live arm is code-default False (risk.controls). Do not invent a swap key.
# FOMO user-wallet REST burns credits — leave off unless you accept the cost:
FOMO_USER_WALLET_LOOKUP=0
# Paid X path off unless you explicitly enable:
X_PAID_ENABLED=0
# X_MONTHLY_CALL_BUDGET=2000
ROBINHOOD_ENABLED=1

# --- Tuning (safe defaults) ---
WIN_MULTIPLE=5.0
ALERT_MIN_P=0.7
BACKFILL_LIMIT=20
FOMO_POLL_SECONDS=600
FOMO_ALERTS_MIN_USD=2000
HUNT_LAST_SECONDS=60
BATCH_FIT_SECONDS=3600
LIVE_SOCIAL_SECONDS=720

# Explicitly NEVER set in this public paper snapshot:
# GMGN_PRIVATE_KEY
# any wallet signer / swap broker credentials
# Railway project tokens / service account tokens
